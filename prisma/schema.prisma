generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                                                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                                           String                     @unique
  displayName                                        String                     @map("display_name")
  password                                           String
  joinedAt                                           DateTime?                  @default(now()) @map("joined_at") @db.Timestamptz(6)
  color                                              String?                    @default("d2b34e") @db.VarChar(6)
  settings                                           Json?                      @default("{}") @db.Json
  is_admin                                           Boolean?                   @default(false)
  folder_dialogue                                    Int                        @default(0)
  gallery                                            String?
  chat_message                                       chat_message[]             @relation("chat_message_sender")
  dm_conversation_dm_conversation_user_id_1Toprofile dm_conversation[]          @relation("dm_conversation_user_id_1Toprofile")
  dm_conversation_dm_conversation_user_id_2Toprofile dm_conversation[]          @relation("dm_conversation_user_id_2Toprofile")
  dm_message                                         dm_message[]
  genus                                              genus[]                    @relation("genus_creator")
  genus_notifications                                genus_notifications[]
  genus_permission                                   genus_permission[]
  genus_permission_frozen                            genus_permission_frozen[]
  message_reactions                                  message_reactions[]
  netdoc_version                                     netdoc_version[]
  netdoc_view                                        netdoc_view[]
  notifications_notifications_user_idToprofile       notifications[]            @relation("notifications_user_idToprofile")
  genus_profile_galleryToGenus                       genus?                     @relation("profile_galleryToGenus", fields: [gallery], references: [id], onDelete: NoAction, onUpdate: NoAction)
  space_folders                                      space_folders[]
  space_items                                        space_items[]
  space_members                                      space_members[]
  space_permission                                   space_permission[]
  spaces                                             spaces[]                   @relation("spaces_owner")
  tos_acceptances                                    tos_acceptance[]
  user_space_subscriptions                           user_space_subscriptions[]

  @@index([username], map: "idx_profile_username")
  @@map("profile")
}

model tos_acceptance {
  id          BigInt   @id @default(autoincrement())
  profile_id  String   @db.Uuid
  tos_version String   @db.VarChar(50)
  accepted_at DateTime @default(now()) @db.Timestamptz(6)
  ip_address  String?  @db.VarChar(45)
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profile_id], map: "idx_tos_profile")
  @@index([tos_version], map: "idx_tos_version")
}

model genus {
  id                             String                    @id
  name                           String                    @db.VarChar(500)
  creator_id                     String?                   @db.Uuid
  space_id                       String?
  perms_mode_read                perms_mode                @default(blacklist)
  perms_mode_write               perms_mode                @default(whitelist)
  perms_mode_comment             perms_mode                @default(blacklist)
  is_unlisted                    Boolean                   @default(false)
  created_at                     DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime?                 @default(now()) @db.Timestamptz(6)
  chat                           chat?
  profile                        Profile?                  @relation("genus_creator", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space                          spaces?                   @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genus_notifications            genus_notifications[]
  genus_permission               genus_permission[]
  genus_permission_frozen        genus_permission_frozen[]
  netdoc                         netdoc?
  notifications                  notifications[]
  profile_profile_galleryToGenus Profile[]                 @relation("profile_galleryToGenus")

  @@index([creator_id], map: "idx_genus_creator")
  @@index([space_id], map: "idx_genus_space")
}

model netdoc {
  id                            String           @id
  content                       String           @default("")
  yjs_state                     Bytes?
  hide_history_from_non_editors Boolean          @default(false)
  status_message                Boolean          @default(false)
  is_jacket                     Boolean          @default(false)
  updated_at                    DateTime?        @default(now()) @db.Timestamptz(6)
  genus                         genus            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  netdoc_version                netdoc_version[]
  netdoc_view                   netdoc_view[]
}

model chat {
  id                     String         @id
  is_standalone          Boolean        @default(false)
  topic                  String?        @db.VarChar(390)
  users_can_change_topic Boolean        @default(false)
  updated_at             DateTime?      @default(now()) @db.Timestamptz(6)
  genus                  genus          @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages               chat_message[]
}

model chat_message {
  id                BigInt              @id @default(autoincrement())
  chat_id           String
  content           String              @default("")
  sender_id         String?             @db.Uuid
  reply_to          BigInt?
  status_message    Boolean             @default(false)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  chat              chat                @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reply_target      chat_message?       @relation("message_replies", fields: [reply_to], references: [id], onUpdate: NoAction)
  replies           chat_message[]      @relation("message_replies")
  sender            Profile?            @relation("chat_message_sender", fields: [sender_id], references: [id], onUpdate: NoAction)
  message_reactions message_reactions[]

  @@index([chat_id], map: "idx_chat_message_chat")
  @@index([created_at], map: "idx_chat_message_created")
  @@index([chat_id, created_at], map: "idx_chat_message_chat_created")
}

model genus_permission {
  id              BigInt    @id @default(autoincrement())
  genus_id        String
  permission_type String    @db.VarChar(50)
  user_id         String?   @db.Uuid
  is_blacklist    Boolean   @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  genus           genus     @relation(fields: [genus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile         Profile?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([genus_id, permission_type, user_id, is_blacklist])
  @@index([genus_id], map: "idx_genus_permission_genus")
  @@index([permission_type], map: "idx_genus_permission_type")
  @@index([genus_id, permission_type, user_id], map: "idx_genus_permission_lookup")
}

model netdoc_version {
  id         BigInt    @id @default(autoincrement())
  netdoc_id  String
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  title      String    @db.VarChar(500)
  author     String    @db.Uuid
  profile    Profile   @relation(fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  netdoc     netdoc    @relation(fields: [netdoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model spaces {
  id                       String                     @id
  name                     String                     @db.VarChar(255)
  description              String?
  monarch_id               String?                    @db.Uuid
  is_profile               Boolean                    @default(false)
  is_collection            Boolean                    @default(false)
  deleted_creator          Boolean                    @default(false)
  jacket                   String?                    @unique
  avatar_url               String?
  perms_mode_read          perms_mode                 @default(blacklist)
  perms_mode_write         perms_mode                 @default(whitelist)
  perms_mode_comment       perms_mode                 @default(blacklist)
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  genus                    genus[]
  genus_permission_frozen  genus_permission_frozen[]
  folders                  space_folders[]
  items                    space_items[]              @relation("space_items_to_spaces")
  members                  space_members[]
  space_permission         space_permission[]
  monarch                  Profile?                   @relation("spaces_owner", fields: [monarch_id], references: [id], onUpdate: NoAction)
  user_space_subscriptions user_space_subscriptions[]

  @@index([monarch_id], map: "idx_spaces_monarch")
}

model space_members {
  id        BigInt    @id @default(autoincrement())
  space_id  String
  user_id   String    @db.Uuid
  role      String    @default("member") @db.VarChar(50)
  joined_at DateTime? @default(now()) @db.Timestamptz(6)
  space     spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile   Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([space_id, user_id])
  @@index([space_id], map: "idx_space_members_space")
  @@index([user_id], map: "idx_space_members_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model space_folders {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?         @db.Uuid
  space_id            String?
  parent_folder_id    String?         @db.Uuid
  name                String          @db.VarChar(255)
  is_open             Boolean?        @default(true)
  order_key           Int
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  space_folders       space_folders?  @relation("space_foldersTospace_folders", fields: [parent_folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sidebar_folders_parent_folder_id_fkey")
  other_space_folders space_folders[] @relation("space_foldersTospace_folders")
  space               spaces?         @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile             Profile?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sidebar_folders_user_id_fkey")
  space_items         space_items[]

  @@unique([user_id, parent_folder_id, order_key])
  @@index([user_id], map: "idx_folders_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model space_items {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?        @db.Uuid
  space_id      String?
  genus_id      String
  folder_id     String?        @db.Uuid
  order_key     Int
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  space_folders space_folders? @relation(fields: [folder_id], references: [id], onUpdate: NoAction, map: "sidebar_items_folder_id_fkey")
  space         spaces?        @relation("space_items_to_spaces", fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile       Profile?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sidebar_items_user_id_fkey")

  @@unique([user_id, folder_id, order_key])
  @@unique([user_id, genus_id])
  @@index([genus_id], map: "idx_sidebar_genus")
  @@index([user_id, order_key], map: "idx_sidebar_user_order")
}

model user_space_subscriptions {
  id         BigInt    @id @default(autoincrement())
  user_id    String    @db.Uuid
  space_id   String
  order_key  Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  space      spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, space_id])
  @@index([user_id, order_key], map: "idx_user_space_subscriptions_user_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dm_conversation {
  id                                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id_1                                  String       @db.Uuid
  user_id_2                                  String       @db.Uuid
  created_at                                 DateTime?    @default(now()) @db.Timestamptz(6)
  profile_dm_conversation_user_id_1Toprofile Profile      @relation("dm_conversation_user_id_1Toprofile", fields: [user_id_1], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile_dm_conversation_user_id_2Toprofile Profile      @relation("dm_conversation_user_id_2Toprofile", fields: [user_id_2], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dm_message                                 dm_message[]

  @@unique([user_id_1, user_id_2])
  @@index([user_id_1, user_id_2], map: "idx_dm_conversation_users")
}

model dm_message {
  id              BigInt          @id @default(autoincrement())
  conversation_id String          @db.Uuid
  sender_id       String?         @db.Uuid
  content         String          @default("")
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  dm_conversation dm_conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile         Profile?        @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_dm_message_conversation")
  @@index([sender_id], map: "idx_dm_message_sender")
  @@index([conversation_id, created_at], map: "idx_dm_message_created")
}

model netdoc_view {
  id        BigInt    @id @default(autoincrement())
  netdoc_id String
  viewer_id String    @db.Uuid
  viewed_at DateTime? @default(now()) @db.Timestamptz(6)
  netdoc    netdoc    @relation(fields: [netdoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile   Profile   @relation(fields: [viewer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([netdoc_id, viewer_id])
  @@index([netdoc_id], map: "idx_netdoc_view_netdoc")
  @@index([viewed_at], map: "idx_netdoc_view_time")
}

model genus_notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    String    @db.Uuid
  genus_id   String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  genus      genus     @relation(fields: [genus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, genus_id])
  @@index([user_id], map: "idx_genus_notifications_user")
}

model notifications {
  id                                     BigInt    @id @default(autoincrement())
  user_id                                String    @db.Uuid
  genus_id                               String?
  type                                   String    @db.VarChar(50)
  message                                String
  content                                String?
  read                                   Boolean?  @default(false)
  created_at                             DateTime? @default(now()) @db.Timestamptz(6)
  genus                                  genus?    @relation(fields: [genus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile_notifications_user_idToprofile Profile   @relation("notifications_user_idToprofile", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_user")
  @@index([read], map: "idx_notifications_read")
}

model genus_permission_frozen {
  id                 BigInt    @id @default(autoincrement())
  genus_id           String
  permission_type    String    @db.VarChar(50)
  user_id            String?   @db.Uuid
  is_blacklist       Boolean   @default(false)
  frozen_by_space_id String
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  spaces             spaces    @relation(fields: [frozen_by_space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genus              genus     @relation(fields: [genus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile            Profile?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([genus_id, permission_type, user_id, is_blacklist, frozen_by_space_id])
  @@index([genus_id], map: "idx_genus_perm_frozen_genus")
  @@index([frozen_by_space_id], map: "idx_genus_perm_frozen_space")
  @@index([user_id], map: "idx_genus_perm_frozen_user")
}

model space_permission {
  id              BigInt    @id @default(autoincrement())
  space_id        String
  permission_type String    @db.VarChar(50)
  user_id         String?   @db.Uuid
  is_blacklist    Boolean   @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  spaces          spaces    @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile         Profile?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([space_id, permission_type, user_id, is_blacklist])
  @@index([space_id, permission_type, user_id], map: "idx_space_permission_lookup")
  @@index([space_id], map: "idx_space_permission_space")
}

model message_reactions {
  id           BigInt       @id @default(autoincrement())
  message_id   BigInt
  user_id      String       @db.Uuid
  reaction     String       @db.VarChar(50)
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  chat_message chat_message @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile      Profile      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([message_id, user_id])
  @@index([message_id], map: "idx_message_reactions_message")
  @@index([user_id], map: "idx_message_reactions_user")
}

enum perms_mode {
  whitelist
  blacklist
}
