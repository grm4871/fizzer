generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String          @unique
  displayName   String          @map("display_name")
  joinedAt      DateTime?       @default(now()) @map("joined_at") @db.Timestamptz(6)
  participants  participants[]
  posts         Post[]
  sidebar_items sidebar_items[]

  @@index([username], map: "idx_profile_username")
  @@map("profile")
}

model Post {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content         String
  channelId       String          @map("channel_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  createdAt       DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  post_type_in_db post_type_enum  @default(message)
  documents       documents?
  author          Profile         @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  channel         channel         @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sidebar_items   sidebar_items[]

  @@index([authorId], map: "idx_post_author_id")
  @@index([channelId, createdAt(sort: Desc)], map: "idx_post_channel_created")
  @@index([channelId], map: "idx_post_channel_id")
  @@index([createdAt(sort: Desc)], map: "idx_post_created_at")
  @@index([post_type_in_db], map: "idx_post_type_in_db")
  @@map("post")
}

model documents {
  id           String          @id @db.Uuid
  title        String          @db.VarChar(500)
  status       document_status @default(draft)
  privacy      privacy_level   @default(private)
  forkable     Boolean         @default(true)
  updated_at   DateTime        @default(now()) @db.Timestamp(6)
  content_hash String?
  post         Post            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([privacy], map: "idx_documents_privacy")
  @@index([status], map: "idx_documents_status")
  @@index([updated_at], map: "idx_documents_updated")
  @@map("documents")
}

model channel {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?         @db.VarChar(50)
  participants  participants[]
  post          Post[]
  sidebar_items sidebar_items[]
}

model participants {
  user_id    String    @db.Uuid
  channel_id String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  channel    channel   @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, channel_id])
  @@index([channel_id], map: "idx_participants_channel")
  @@index([user_id], map: "idx_participants_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sidebar_items {
  user_id    String    @db.Uuid
  post_id    String    @db.Uuid
  channel_id String    @db.Uuid
  order_key  Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  channel    channel   @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id, channel_id])
  @@unique([user_id, order_key])
  @@index([user_id, order_key], map: "idx_sidebar_user_order")
}

enum document_status {
  draft
  working
}

enum permission_level {
  view
  edit
}

enum privacy_level {
  private
  unlisted
  public
}

enum post_type_enum {
  message
  document
}
