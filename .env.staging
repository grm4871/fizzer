# Cascade Staging Environment Configuration
# Use this in the staging folder

# Database Connection (use staging database on port 5434)
PGUSER=cascade
PGPASSWORD=cascade_staging_password
PGDATABASE=cascade
PGPORT=5434
PGHOST=localhost

# Server Configuration - Different ports for staging
PORT=5174
API_PORT=3001
VITE_PORT=5174

# Application Settings
NODE_ENV=staging

# Prisma Database URL
DATABASE_URL="postgresql://cascade:cascade_staging_password@localhost:5434/cascade?schema=public"
