{
  "name": "Fizzer",
  "author": "Fizzer",
  "description": "Fizzer shared workspace",
  "main": "cascade-electron/main.cjs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "postinstall": "node -e \"try{require('fs').accessSync('scripts/rebuild-natives.cjs')}catch{process.exit(0)};require('child_process').spawnSync(process.execPath,['scripts/rebuild-natives.cjs','--postinstall'],{stdio:'inherit',env:process.env}).status&&process.exit(1)\"",
    "rebuild:native": "node scripts/rebuild-natives.cjs",
    "dev-backend": "tsx watch index.ts",
    "dev-backend-debug": "tsx watch index.ts --debug",
    "dev-client": "dotenv -- npm --workspace=client run dev",
    "dev-client-no-refresh": "VITE_DISABLE_AUTO_REFRESH=true CASCADE_DISABLE_AUTO_REFRESH=true dotenv -- npm --workspace=client run dev",
    "dev-instance": "node scripts/dev-instance.cjs",
    "dev-verify": "node scripts/dev-instance.cjs --name verify --api-port 3000 --client-port 5174 --shared-backend",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-client\" \"npm run sub:electron\"",
    "dev-no-refresh": "concurrently \"npm run dev-backend\" \"npm run dev-client-no-refresh\" \"npm run sub:electron\"",
    "dev-debug": "concurrently \"npm run dev-backend-debug\" \"npm run dev-client\" \"npm run sub:electron\"",
    "dev-headless": "concurrently \"npm run dev-backend\" \"npm run dev-client\"",
    "dev-headless-debug": "concurrently \"npm run dev-backend-debug\" \"npm run dev-client\"",
    "dev-backend-staging": "dotenv -e .env.staging -- tsx watch index.ts",
    "dev-client-staging": "dotenv -e client/.env.staging -- npm --workspace=client run dev -- --mode staging",
    "dev-staging-headless": "concurrently \"npm run dev-backend-staging\" \"npm run dev-client-staging\"",
    "sub:electron": "cd cascade-electron && npm run start:watch",
    "live": "cd cascade-electron && npm run start-live-instance",
    "build": "tsc && node scripts/copy-cli-agent-wrappers.cjs",
    "build:vps": "npm run build && npm run build:client",
    "start:vps": "node dist/index.js",
    "test": "npm --workspace=client run test",
    "test:server": "tsx --test server/*.test.ts",
    "test:native": "node --test scripts/rebuild-natives.test.cjs",
    "test:desktop-runner": "node scripts/test-desktop-runner-e2e.mjs",
    "test:electron": "node --test cascade-electron/*.test.cjs",
    "test:cli-agents": "tsx --test cli-agents/*.test.ts",
    "test:chat-delete": "node scripts/test-chat-delete-e2e.mjs",
    "test:chat-forward": "node scripts/test-chat-forward-e2e.mjs",
    "test:chat-mission": "node scripts/test-chat-mission-e2e.mjs",
    "test:account": "node scripts/test-account-e2e.mjs",
    "test:e2e": "npm run test:chat-delete && npm run test:chat-forward && npm run test:chat-mission && npm run test:account",
    "test:release": "npm run build:vps && npm run verify:client-performance && npm test && npm run test:server && npm run test:e2e && npm run verify:client-runtime && npm run verify:notes-ui && npm run verify:tab-menus && npm run verify:chat-forward-ui && npm run verify:chat-mission-ui && npm run verify:account-ui && npm run verify:discovery-dms-ui && npm run verify:updates-ui && npm run test:electron && npm run test:cli-agents && npm run verify:workspaces-ui && npm run verify:vault-rename-ui && npm run verify:reply-jump-ui",
    "verify:client-runtime": "node scripts/verify-client-runtime.mjs",
    "verify:client-performance": "node scripts/verify-client-performance.mjs",
    "verify:notes-ui": "node scripts/verify-notes-ui.mjs",
    "verify:chat-delete-ui": "node scripts/verify-chat-delete-ui.mjs",
    "verify:chat-forward-ui": "node scripts/verify-chat-forward-ui.mjs",
    "verify:chat-swipe-reply-ui": "node scripts/verify-chat-swipe-reply-ui.mjs",
    "verify:chat-mission-ui": "node scripts/verify-chat-mission-ui.mjs",
    "verify:account-ui": "node scripts/verify-account-ui.mjs",
    "verify:discovery-dms-ui": "node scripts/verify-discovery-dms-ui.mjs",
    "verify:updates-ui": "node scripts/verify-updates-ui.mjs",
    "verify:tab-menus": "node scripts/verify-tab-menus.mjs",
    "verify:reply-jump-ui": "node scripts/verify-reply-jump-ui.mjs",
    "verify:vault-rename-ui": "node scripts/verify-vault-rename-ui.mjs",
    "verify:workspaces-ui": "node scripts/verify-workspaces-ui.mjs",
    "verify:mobile-navigation-ui": "node scripts/verify-mobile-navigation-ui.mjs",
    "start": "npm --prefix cascade-electron run start",
    "package": "npm --prefix cascade-electron run package",
    "make": "npm --prefix cascade-electron run make",
    "build:client": "npm --workspace=client run build",
    "build:client:android": "CAPACITOR=true dotenv -e client/android.env -- npm --workspace=client run build",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npm run build:client:android && node scripts/prepare-capacitor-assets.mjs && npm run cap:sync",
    "android:apk": "npm run android:build && cd android && JAVA_HOME=\"${JAVA_HOME:-$HOME/.local/jdks/jdk-21.0.11+10}\" ./gradlew clean assembleDebug && cp -f app/build/outputs/apk/debug/app-debug.apk ../client/public/cascade-android.apk && cp -f app/build/outputs/apk/debug/app-debug.apk ../client/dist/cascade-android.apk"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.175",
    "@tobilu/qmd": "^2.5.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^15.0.12",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0",
    "playwright": "^1.61.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tar": ">=7.5.16",
    "@inquirer/editor": ">=4.2.16",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.1.0"
  }
}
