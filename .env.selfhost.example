# Copy to .env.selfhost and replace every example value.
# The public URL and allowed browser origin are normally the same exact origin.
CASCADE_PUBLIC_URL=https://fizzer-host.example.ts.net
CASCADE_ALLOWED_ORIGINS=https://fizzer-host.example.ts.net

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Absolute host directory containing SQLite, vault files, and indexes.
FIZZER_DATA_DIR=/srv/fizzer/data

# Optional local port and image overrides.
FIZZER_PORT=3000
FIZZER_IMAGE=fizzer:selfhost
