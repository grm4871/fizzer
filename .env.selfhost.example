# Copy to .env.selfhost and replace every example value.
# The public URL and allowed browser origin must be the same exact origin.
CASCADE_PUBLIC_URL=https://fizzer-host.example.ts.net
CASCADE_ALLOWED_ORIGINS=https://fizzer-host.example.ts.net

# Required in network mode. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Absolute host directory containing SQLite, vault files, indexes, and
# persisted .cascade secrets. It must be writable by UID/GID 1000:1000.
FIZZER_DATA_DIR=/srv/fizzer/data

# Host loopback port; the container still listens on 3000.
FIZZER_PORT=3000
FIZZER_IMAGE=fizzer:selfhost

# Keep zero unless exactly one trusted HTTPS proxy is the only ingress and its
# X-Forwarded-For chain has been verified.
CASCADE_TRUST_PROXY_HOPS=0
