# Cascade Environment Configuration
# Copy this file to .env and update with your actual values

# Database Connection
PGUSER=cascade
PGPASSWORD=cascade_dev_password
PGDATABASE=cascade
PGPORT=5433
PGHOST=localhost

# Server Configuration
API_PORT=3000

# Client Configuration
VITE_SOCKET_URL=http://localhost:3000
VITE_PORT=5173

# Queue Configuration
MAX_CONNECTIONS=50

# Application Settings
NODE_ENV=development

# Prisma Database URL
DATABASE_URL="postgresql://cascade:cascade_dev_password@localhost:5433/cascade?schema=public"

