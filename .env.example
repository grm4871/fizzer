# Cascade Environment Configuration
# Copy this file to .env and update with your actual values

# Database Connection
PGUSER=cascade
PGPASSWORD=cascade_dev_password
PGDATABASE=cascade
PGPORT=5433
PGHOST=localhost

# Server Configuration
PORT=5173
API_PORT=3000
# API_HOST defaults to 127.0.0.1 locally and 0.0.0.0 when CASCADE_NETWORK_MODE=true.
# API_HOST=0.0.0.0

# Application Settings
NODE_ENV=development

# VPS / shared network mode
# Enables stricter defaults for a server reachable beyond localhost.
# CASCADE_NETWORK_MODE=true
# Comma-separated browser origins allowed to call the API or open sockets.
# Use the public scheme and host that users open in their browser.
# CASCADE_ALLOWED_ORIGINS=https://cascade.example.com
# Canonical origin used in publish and invite links; avoids Host-header ambiguity.
# CASCADE_PUBLIC_URL=https://cascade.example.com
# Set a long random value, or omit it and Cascade will persist one at ~/.cascade/secret.
# JWT_SECRET=
# Number of trusted reverse-proxy hops for req.ip/rate limiting.
# CASCADE_TRUST_PROXY_HOPS=1
# Optional production database and client build paths.
# DOCS_DB_PATH=/var/lib/cascade/docs.db
# CASCADE_CLIENT_DIST=/opt/cascade/client/dist

# Prisma Database URL
DATABASE_URL="postgresql://cascade:cascade_dev_password@localhost:5433/cascade?schema=public"

# AI Agent Backends
#
# Agent processes run in the desktop on the computer that owns the run. Provider
# logins and subscriptions stay on that computer; these settings do not move
# provider credentials to the server.
#
# Claude Code — local `claude` CLI. Authentication is the local Claude login or
# ANTHROPIC_API_KEY.
CLAUDE_BIN=claude
ANTHROPIC_API_KEY=
RUNNER_MODEL=claude-sonnet-5
# Claude effort defaults to medium; chat runs use RUNNER_CHAT_EFFORT when set.
RUNNER_EFFORT=medium
RUNNER_CHAT_EFFORT=medium
#
# Codex — local `codex` CLI. Run `codex login` on the desktop first.
CODEX_BIN=codex
# Persistent Codex app-server is enabled for the normal `codex` binary. Set to
# 0 only when the local CLI cannot use app-server.
RUNNER_CODEX_PERSISTENT=1
#
# Grok — local `grok` CLI. Sign in with the local CLI first.
GROK_BIN=grok
#
# Antigravity — local language-server `agentapi`.
# ANTIGRAVITY_BIN=/absolute/path/to/agentapi
#
# Copilot — local `copilot` CLI.
COPILOT_BIN=copilot
#
# Hermes and its Akron Grok launcher.
HERMES_BIN=hermes
AKRON_BIN=akron
#
# OMP and Pi JSON-mode CLIs.
OMP_BIN=omp
PI_BIN=pi
#
# Shared CLI inactivity override (milliseconds). This is reset whenever the
# child emits stdout or stderr; it is not a wall-clock limit on useful work.
# RUNNER_CLI_IDLE_TIMEOUT=1800000
# RUNNER_CLI_TIMEOUT is the legacy name for the same inactivity override.
# RUNNER_CLI_TIMEOUT=600000
