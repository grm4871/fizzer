# Cascade Environment Configuration
# Copy this file to .env and update with your actual values

# Database Connection
PGUSER=cascade
PGPASSWORD=cascade_dev_password
PGDATABASE=cascade
PGPORT=5433
PGHOST=localhost

# Server Configuration
PORT=5173
API_PORT=3000

# Application Settings
NODE_ENV=development

# Prisma Database URL
DATABASE_URL="postgresql://cascade:cascade_dev_password@localhost:5433/cascade?schema=public"

# AI Agent Backends
#
# Three selectable agents. Each runs under its own auth — no API keys needed
# for Codex/Grok beyond being logged into their CLIs.
#
# Claude Code (default) — Anthropic Agent SDK.
#   Auth: your Claude subscription / `claude` login, or ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# RUNNER_MODEL=claude-sonnet-4-6
#
# Codex — drives the local `codex` CLI (`codex exec`). Run `codex login` first.
# CODEX_BIN=codex            # override if not on the server's PATH
#
# Grok — drives the local `grok` CLI (`grok --single`). Log in via `grok` first.
# GROK_BIN=grok              # override if not on the server's PATH
#
# Shared: max wall-clock per CLI run before it's killed (ms).
# RUNNER_CLI_TIMEOUT=600000