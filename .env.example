# Netaris Environment Configuration
# Copy this file to .env and update with your actual values

# Database Connection
PGUSER=netaris
PGPASSWORD=netaris_dev_password
PGDATABASE=netaris
PGPORT=5433
PGHOST=localhost

# Server Configuration
PORT=5173
API_PORT=3000

# Application Settings
NODE_ENV=development

# Prisma Database URL
DATABASE_URL="postgresql://netaris:netaris_dev_password@localhost:5433/netaris?schema=public"