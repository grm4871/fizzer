# Copy to the repository root as .env before deploying:
#   cp deploy/.env.example .env
# Keep this file root-owned and mode 0600 on production hosts.

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Exact public origin, including https://. Custom domains must set this.
CASCADE_PUBLIC_URL=https://cscd.example.com
CASCADE_ALLOWED_ORIGINS=https://cscd.example.com
